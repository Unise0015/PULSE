# PULSE CVE Scanner CLI Configuration Example
# Copy this file to ~/.pulse/.env or project root .env

# NVD API Key (Optional, speeds up initial enrichment)
NVD_API_KEY=your_nvd_api_key_here

# Runtime Settings
OFFLINE_MODE=false
VERBOSE_MODE=false
DEBUG_MODE=false
SUMMARY_MODE=NORMAL

# Report Settings
REPORT_DEFAULT_FORMAT=HTML
REPORT_DEFAULT_LOCATION=documents
# REPORT_CUSTOM_DIR=E:\SecurityReports
REPORT_KEEP_HISTORY=100
