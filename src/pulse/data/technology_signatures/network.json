    "cats": ["Network OS"],
    "cpe": "cpe:2.3:o:cisco:ios:*:*:*:*:*:*:*:*",
    "headers": {
      "Server": "^cisco-IOS(?: ([0-9.]+))?\\;version:\\1"
    }
  },
  "MikroTik RouterOS": {
    "domain": "network",
    "vendor": "MikroTik",
