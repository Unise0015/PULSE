    "cpe": "cpe:2.3:o:mikrotik:routeros:*:*:*:*:*:*:*:*",
    "headers": {
      "Server": "^MikroTik(?:/([0-9.]+))?\\;version:\\1"
    }
  },
  "Ubiquiti UniFi": {
    "domain": "network",
    "vendor": "Ubiquiti",
    "cats": ["Network Controller"],
    "cpe": "cpe:2.3:a:ubiquiti:unifi_network_application:*:*:*:*:*:*:*:*",
    "headers": {
